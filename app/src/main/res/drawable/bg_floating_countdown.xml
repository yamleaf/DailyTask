<?xml version="1.0" encoding="utf-8"?>
<!--
    打卡倒计时卡：晨曦暖调玉珠质感（与导航选中态暖色系统一）
    - 基底：半透明暖奶油→蜜桃线性渐变
    - 顶部高光层：上亮下透的球面受光
    - 细描边：柔和蜜桃描边
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 基底：半透明暖奶油→蜜桃 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:centerColor="#D9F6E2C9"
                android:endColor="#CCEFD2AF"
                android:startColor="#E6FBF3E8"
                android:type="linear" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <!-- 顶部高光：模拟球面受光（上亮下透） -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#1AFFFFFF"
                android:endColor="#00FFFFFF"
                android:startColor="#66FFFFFF"
                android:type="linear" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <!-- 细描边 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="@color/float_accent_soft" />
        </shape>
    </item>
</layer-list>