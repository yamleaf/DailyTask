<?xml version="1.0" encoding="utf-8"?>
<!-- 半透明深色玻璃底：降低对目标 App 内容的遮挡，截图前渐隐时更干净 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="120"
        android:startColor="@color/float_bg_start"
        android:centerColor="@color/float_bg_center"
        android:endColor="@color/float_bg_end" />
    <corners android:radius="18dp" />
    <stroke
        android:width="1dp"
        android:color="@color/float_accent_soft" />
</shape>
