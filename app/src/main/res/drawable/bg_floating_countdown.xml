<?xml version="1.0" encoding="utf-8"?>
<!-- 半透明深色玻璃底：降低对目标 App 内容的遮挡，截图前渐隐时更干净 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="120"
        android:startColor="#E612141C"
        android:centerColor="#CC161A24"
        android:endColor="#B3181C28" />
    <corners android:radius="18dp" />
    <stroke
        android:width="1dp"
        android:color="#66E8C07A" />
</shape>
