<?xml version="1.0" encoding="utf-8"?>
<!-- 悬浮导航卡片背景：对齐控制端 bg_nav_floating.xml 风格。
     投影 + 实色表面卡片 + 细描边 = 明显的浮起质感。
     BlurView 仍会模糊下方内容，卡片本身不透明。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 柔和投影层 -->
    <item
        android:left="0dp"
        android:top="4dp"
        android:right="0dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#1A000000" />
            <corners android:radius="24dp" />
        </shape>
    </item>

    <!-- 表面卡片：实色 + 圆角 + 细描边 -->
    <item
        android:left="2dp"
        android:top="0dp"
        android:right="2dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/md_surface" />
            <stroke
                android:width="1dp"
                android:color="@color/md_outlineVariant" />
            <corners android:radius="24dp" />
        </shape>
    </item>

</layer-list>
