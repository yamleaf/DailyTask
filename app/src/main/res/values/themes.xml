<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ShapeAppearance 圆角体系（收敛到 protocol 令牌阶梯） -->
    <style name="ShapeAppearance.DailyTask.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerSize">@dimen/dp_4</item>
    </style>
    <style name="ShapeAppearance.DailyTask.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">@dimen/radius_pill</item>
    </style>
    <style name="ShapeAppearance.DailyTask.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">@dimen/radius_dialog</item>
    </style>
    <style name="ShapeAppearance.DailyTask.XL" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">@dimen/radius_nav_card</item>
    </style>
    <style name="ShapeAppearance.DailyTask.Full" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">@dimen/radius_floating_nav</item>
    </style>
    <!-- 底部面板：仅顶部 24dp 圆角（统一规范） -->
    <style name="ShapeAppearance.DailyTask.BottomSheet" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- 弹窗入场/出场动画（scale + fade，200ms / 150ms） -->
    <style name="Animation.DailyTask.DialogScale" parent="@android:style/Animation">
        <item name="android:windowEnterAnimation">@anim/dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/dialog_exit</item>
    </style>

    <!-- 统一输入框样式（12dp 圆角，双端一致） -->
    <style name="ShapeAppearance.DailyTask.Input" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">@dimen/radius_input</item>
    </style>
    <style name="Widget.DailyTask.TextInput.Outlined" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="shapeAppearance">@style/ShapeAppearance.DailyTask.Input</item>
    </style>

    <!-- Base application theme.（DayNight：随系统/用户设置在浅色与深色间切换） -->
    <style name="Base.Theme.DailyTask" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- 修改控件系统默认颜色 -->
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorPrimaryContainer">@color/md_primaryContainer</item>
        <item name="colorOnPrimary">@color/md_onPrimary</item>
        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorError">@color/md_error</item>
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorSurfaceVariant">@color/md_surfaceVariant</item>
        <item name="colorOnSurface">@color/md_onSurface</item>
        <item name="colorOnSurfaceVariant">@color/md_onSurfaceVariant</item>
        <item name="colorOutline">@color/md_outline</item>
        <item name="colorOutlineVariant">@color/md_outlineVariant</item>
        <!-- 波纹色（品牌蓝 8%）替代系统默认灰 -->
        <item name="android:colorControlHighlight">@color/color_ripple</item>
        <!-- 统一 Snackbar（§3.16） -->
        <item name="snackbarStyle">@style/Widget.Daily.Snackbar</item>
        <item name="snackbarTextViewStyle">@style/TextAppearance.Daily.Snackbar</item>
        <item name="snackbarButtonStyle">@style/TextAppearance.Daily.Snackbar.Action</item>
        <item name="android:colorBackground">@color/md_background</item>
        <item name="android:windowBackground">@color/md_background</item>
        <!-- 状态栏统一为 DC 策略：透明 + 渐变 AppBar 延伸到状态栏（v1.2 用户拍板） -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- 导航栏跟随明暗：浅色模式深色图标，深色模式浅色图标 -->
        <item name="android:navigationBarColor">@color/md_surface</item>
        <item name="android:windowLightNavigationBar">@bool/light_system_bars</item>
        <!-- 对话框主题（统一规范：28dp 圆角 + 胶囊按钮，双端共用 :protocol 弹窗体系） -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Daily.UnifiedDialog</item>
        <!-- BottomSheet 主题（方案 C1，统一底部弹窗圆角/背景） -->
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.DailyTask.BottomSheetDialog</item>
        <!-- 窗口转场：用系统合成（自动尊重系统「减少动态效果」缩放），替代已弃用的 overridePendingTransition -->
        <item name="android:windowActivityTransitions">true</item>
        <item name="android:windowEnterTransition">@transition/fade</item>
        <item name="android:windowExitTransition">@transition/fade</item>
        <item name="android:windowReenterTransition">@transition/fade</item>
        <item name="android:windowReturnTransition">@transition/fade</item>
    </style>

    <!-- 底部面板主题：顶部 24dp 圆角 + 缩放从底部滑入 -->
    <style name="ThemeOverlay.DailyTask.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="shapeAppearance">@style/ShapeAppearance.DailyTask.BottomSheet</item>
        <item name="backgroundTint">@color/md_surface</item>
        <item name="android:windowAnimationStyle">@style/Animation.DailyTask.DialogScale</item>
    </style>

    <style name="Theme.DailyTask" parent="Base.Theme.DailyTask" />
</resources>
