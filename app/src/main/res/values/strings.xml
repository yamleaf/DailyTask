    <string name="settings_accessibility_title">无障碍权限</string>
    <string name="settings_accessibility_tip">服务未开启，无障碍模式无法获取打卡结果</string>
    <string name="settings_gesture_title">手势识别</string>
    <string name="settings_gesture_tip">开启后，双指下滑开启伪息屏，单指/双指上滑关闭</string>
    <string name="settings_power_save_title">节能模式</string>
    <string name="settings_power_save_tip">降低倒计时通知、内存监控和息屏蒙层动画刷新频率</string>
    <string name="settings_boot_auto_schedule_title">开机自动调度</string>
    <string name="settings_boot_auto_schedule_tip">开启且任务列表不为空时，手机重启后自动启动任务调度</string>
    <string name="settings_keep_alive_title">暂停使用</string>
    <string name="settings_keep_alive_tip">开启后立即停止前台/后台服务与全部闹钟；关闭后自动恢复，功能恢复正常</string>
    <string name="settings_keep_alive_confirm_title">开启暂停使用？</string>
    <string name="settings_keep_alive_confirm_tip">开启后将停止前台保活、MQTT、悬浮窗、截屏服务，并取消心跳/重置/电量/MQTT 复活闹钟；通知监听与无障碍由系统托管但仍会忽略业务。关闭本开关后自动恢复全部服务。</string>
    <string name="settings_keep_alive_confirm_second_title">确认暂停使用？</string>
    <string name="settings_keep_alive_confirm_second_tip">再次确认：开启后所有前台、后台与闹钟服务将立即停止，无法打卡、无法接收远程指令、进程被杀不自动重启。\n\n此操作会彻底暂停软件，请确认不是误操作。</string>
    <string name="settings_pseudo_mask_group_title">伪息屏增强</string>
    <string name="settings_pseudo_mask_group_tip">离开本软件超过设定秒数后主动进入伪息屏</string>
    <string name="settings_force_mask_title">伪息屏</string>
    <string name="settings_force_mask_tip">开启后，后台超时或前台无操作超时均进入伪息屏（可能打断其它 App 使用）</string>
    <string name="settings_screen_mode_title">屏幕模式</string>
    <string name="settings_screen_mode_tip">伪息屏关闭时生效：前台无操作后的屏幕行为</string>
    <string name="settings_screen_mode_tip_disabled">伪息屏开启时由伪息屏策略接管，本项不生效</string>
    <string name="settings_screen_mode_pseudo">伪息屏</string>
    <string name="settings_screen_mode_off">息屏</string>
    <string name="settings_screen_mode_keep_on">常亮</string>
    <string name="settings_screen_mode_dialog_title">选择屏幕模式</string>
    <string name="settings_screen_mode_pseudo_desc">前台无操作超过延迟后自动盖全黑蒙层（延迟同「伪息屏延迟」）</string>
    <string name="settings_screen_mode_off_desc">前台允许系统按超时自然灭屏</string>
    <string name="settings_screen_mode_keep_on_desc">前台保持亮屏，阻止系统自动灭屏</string>
    <string name="settings_screen_mode_off_confirm_title">确定使用息屏模式？</string>
    <string name="settings_screen_mode_off_confirm_msg">为保证打卡任务正常进行，请先完成以下设置：\n1. 关闭锁屏密码；\n2. 打开开发者选项，开启「直接进入系统」选项；\n3. 关闭开发者选项。\n\n⚠ 息屏模式下，不能确保任务一定能正常执行，确定使用前，请充分测试验证。</string>
    <string name="settings_screen_mode_off_confirm_positive">确认使用</string>
    <string name="settings_screen_mode_off_confirm_negative">取消</string>
    <string name="settings_keepalive_mode_title">息屏保活</string>
    <string name="settings_keepalive_mode_tip">息屏待机时维持 MQTT 在线的方式。自动：启动时从定时器保活开始，掉线频繁时自动升级；也可固定为某一种级别</string>
    <string name="settings_keepalive_mode_dialog_title">选择息屏保活方式</string>
    <string name="settings_keepalive_mode_auto">自动（推荐）</string>
    <string name="settings_keepalive_mode_auto_desc">启动时从定时器保活开始，掉线频繁时自动升级闹钟/CPU，不降级</string>
    <string name="settings_keepalive_mode_timer">定时器保活</string>
    <string name="settings_keepalive_mode_timer_desc">Paho 定时器线程心跳，最省电；深睡时可能停发心跳被踢线（自动重连兜底）</string>
    <string name="settings_keepalive_mode_alarm">闹钟保活</string>
    <string name="settings_keepalive_mode_alarm_desc">系统精确闹钟驱动心跳，深睡也能唤醒发心跳；需精确闹钟权限/电池白名单</string>
    <string name="settings_keepalive_mode_cpu">CPU 保活</string>
    <string name="settings_keepalive_mode_cpu_desc">息屏持 CPU 锁，心跳最可靠但最耗电</string>
    <string name="settings_keepalive_mode_effect_toast">息屏保活方式将在下次 MQTT 服务启动/MQTT 开启时生效</string>
    <string name="settings_pseudo_mask_delay_title">伪息屏延迟</string>
    <string name="settings_pseudo_mask_delay_tip">离开本软件或前台无操作超过该秒数后进入伪息屏（10~3600，默认 60）</string>
    <string name="settings_pseudo_mask_delay_value">%1$d 秒</string>
    <string name="settings_pseudo_mask_no_clock_title">隐藏息屏时钟</string>
    <string name="settings_pseudo_mask_no_clock_tip">开启后伪息屏仅显示黑屏，不显示时钟，更省电</string>
    <string name="settings_accessibility_enable_warning_title">开启无障碍服务提醒</string>
    <string name="settings_accessibility_enable_warning_msg">钉钉等部分打卡应用会检测无障碍开关。\n\n⚠ 开启后请先手动验证能否正常打卡；\n⚠ 若异常，请关闭刚开启的无障碍服务。</string>
    <string name="settings_capture_enable_warning_title">开启截屏服务提醒</string>
    <string name="settings_capture_enable_warning_msg">截屏服务通过屏幕录制获取打卡画面。\n\n⚠ 状态栏会显示录屏提示，银行/支付类 App 可能受限。\n⚠开启后请先验证能否正常打卡，异常则关闭。</string>
    <string name="settings_back_home_title">返回桌面</string>
    <string name="message_channel_feedback_off_title">静默通知</string>
    <string name="message_channel_feedback_off_tip">开启后将不再发送邮件/企业微信消息（默认关闭）</string>
    <string name="settings_back_home_tip">开启后，打卡倒计时结束，会先退回桌面再启动本软件</string>
