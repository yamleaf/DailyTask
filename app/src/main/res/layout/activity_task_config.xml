<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/md_primary"
        app:navigationIcon="@drawable/ic_title_left"
        app:title="任务配置"
        app:titleTextColor="@color/on_header" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/dp_16"
            style="@style/Widget.Daily.SectionCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <RelativeLayout
                android:id="@+id/resetTimeLayout"
                android:layout_width="match_parent"
                android:layout_height="@dimen/itemLayoutHeight"
                android:background="@android:color/transparent"
                android:paddingHorizontal="@dimen/dp_16">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:gravity="center_vertical"
                    android:text="重置时间"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/resetTimeView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:gravity="center_vertical"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />
            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/dividerLine"
                android:layout_marginHorizontal="@dimen/dp_16"
                android:background="@color/md_outlineVariant" />

            <RelativeLayout
                android:id="@+id/timeoutLayout"
                android:layout_width="match_parent"
                android:layout_height="@dimen/itemLayoutHeight"
                android:background="@android:color/transparent"
                android:paddingHorizontal="@dimen/dp_16">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:gravity="center_vertical"
                    android:text="超时时间"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/timeoutTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:gravity="center_vertical"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />
            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/dividerLine"
                android:layout_marginHorizontal="@dimen/dp_16"
                android:background="@color/md_outlineVariant" />

            <RelativeLayout
                android:id="@+id/keyLayout"
                android:layout_width="match_parent"
                android:layout_height="@dimen/itemLayoutHeight"
                android:background="@android:color/transparent"
                android:paddingHorizontal="@dimen/dp_16">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:gravity="center_vertical"
                    android:text="任务口令"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/keyTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:gravity="center_vertical"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />
            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/dividerLine"
                android:layout_marginHorizontal="@dimen/dp_16"
                android:background="@color/md_outlineVariant" />

            <LinearLayout
                android:id="@+id/workdayLayout"
                android:layout_width="match_parent"
                android:layout_height="@dimen/itemLayoutHeight"
                android:background="@android:color/transparent"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/dp_16">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:text="工作日设置"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/workdayValueView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_16"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/dividerLine"
                android:layout_marginHorizontal="@dimen/dp_16"
                android:background="@color/md_outlineVariant" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/itemLayoutHeight"
                android:background="@android:color/transparent"
                android:paddingHorizontal="@dimen/dp_16">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:gravity="center_vertical"
                    android:text="跳过节假日"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/skipHolidaySwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true" />
            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/dividerLine"
                android:layout_marginHorizontal="@dimen/dp_16"
                android:background="@color/md_outlineVariant" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/itemLayoutHeight"
                android:background="@android:color/transparent"
                android:paddingHorizontal="@dimen/dp_16">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:orientation="vertical">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="循环任务"
                        android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                        android:textColor="@color/md_onSurface" />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="@dimen/dp_4"
                        android:singleLine="true"
                        android:text="注意：此开关只能通过远程指令修改"
                        android:textColor="@color/md_error"
                        android:textSize="@dimen/sp_10" />
                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/autoTaskSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:clickable="false"
                    android:focusable="false" />
            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/dividerLine"
                android:layout_marginHorizontal="@dimen/dp_16"
                android:background="@color/md_outlineVariant" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/itemLayoutHeight"
                android:background="@android:color/transparent"
                android:paddingHorizontal="@dimen/dp_16">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="随机时间"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/randomTimeSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true" />
            </RelativeLayout>

            <LinearLayout
                android:id="@+id/minuteRangeLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dividerLine"
                    android:layout_marginHorizontal="@dimen/dp_16"
                    android:background="@color/md_outlineVariant" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/itemLayoutHeight"
                    android:background="@android:color/transparent"
                    android:paddingHorizontal="@dimen/dp_16">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:text="时间范围"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textColor="@color/md_onSurface" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/minuteRangeView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:gravity="center_vertical"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />
                </RelativeLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/dividerLine"
                android:layout_marginHorizontal="@dimen/dp_16"
                android:background="@color/md_outlineVariant" />

            <RelativeLayout
                android:id="@+id/exportLayout"
                android:layout_width="match_parent"
                android:layout_height="@dimen/itemLayoutHeight"
                android:background="@android:color/transparent"
                android:paddingHorizontal="@dimen/dp_16">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:gravity="center_vertical"
                    android:text="导出配置"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

                <ImageView 
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_arrow_right" android:contentDescription="@null" />
            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/dividerLine"
                android:layout_marginHorizontal="@dimen/dp_16"
                android:background="@color/md_outlineVariant" />

            <RelativeLayout
                android:id="@+id/importLayout"
                android:layout_width="match_parent"
                android:layout_height="@dimen/itemLayoutHeight"
                android:background="@android:color/transparent"
                android:paddingHorizontal="@dimen/dp_16">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:gravity="center_vertical"
                    android:text="导入配置"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

                <ImageView 
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_arrow_right" android:contentDescription="@null" />
            </RelativeLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
