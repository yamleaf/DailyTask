<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            android:background="@drawable/bg_header_gradient"
            android:elevation="@dimen/elev_appbar"
            app:menu="@menu/main_top_bar_menu"
            app:overflowIcon="@drawable/ic_more_vert"
            app:subtitleTextAppearance="@style/TextAppearance.Material3.TitleSmall"
            app:subtitleTextColor="@color/on_header"
            app:titleTextColor="@color/on_header" />

        <LinearLayout
            android:id="@+id/contentView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="@dimen/dp_12"
            android:paddingTop="@dimen/dp_12"
            android:paddingEnd="@dimen/dp_12">

            <!-- 运行状态信息卡（紧凑） -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.Daily.SectionCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/dp_16">

                    <!-- 标题 + 状态点 + 刷新周期：状态用点表达，不再额外占一个胶囊 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/schedulerStatusDotView"
                            android:layout_width="7dp"
                            android:layout_height="7dp"
                            android:layout_marginEnd="@dimen/dp_8"
                            android:background="@drawable/bg_circle_primary"
                            android:backgroundTint="@color/md_onSurfaceVariant"
                            android:importantForAccessibility="no" />

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="任务调度"
                            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                            android:textColor="@color/md_onSurface" />

                        <!-- 刷新周期：右上角次级信息，避免再占一整行 -->
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/repeatTimeView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/dp_8"
                            android:ellipsize="end"
                            android:maxWidth="132dp"
                            android:singleLine="true"
                            android:text="--后重置任务"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:textColor="@color/md_onSurfaceVariant" />
                    </LinearLayout>

                    <!-- 状态正文：只放信息，不再和按钮挤在一行 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_8"
                        android:orientation="vertical">

                        <!-- 第一行：状态主文案 -->
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/tipsView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:hint="点击按钮后开始执行任务"
                            android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                            android:textColor="@color/md_onSurface"
                            android:textColorHint="@color/md_onSurfaceVariant" />

                        <!-- 第二行：执行时间 + 备注（仅调度中展示） -->
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/execDetailView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_6"
                            android:gravity="center_vertical"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:textColor="@color/md_onSurfaceVariant"
                            android:visibility="gone" />

                        <!-- 第三行：调度额外信息（循环/节假日/下次打卡） -->
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/statusExtraView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_4"
                            android:gravity="center_vertical"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:textColor="@color/md_onSurfaceVariant"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- 操作行：打卡记录与启停并排，去掉独立记录行和分隔线 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_12"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPunchRecord"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/dp_40"
                            android:minWidth="0dp"
                            android:minHeight="@dimen/dp_40"
                            android:paddingHorizontal="@dimen/dp_10"
                            android:text="打卡记录"
                            android:textColor="@color/md_primary"
                            android:textSize="@dimen/sp_12"
                            app:cornerRadius="@dimen/radius_button"
                            app:strokeColor="@color/md_outlineVariant"
                            app:strokeWidth="1dp" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <!-- 启动 / 停止按钮（图标与文字由 Fragment 动态切换） -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/executeTaskButton"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/dp_44"
                            android:contentDescription="启动执行任务"
                            android:text="启动"
                            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                            app:cornerRadius="@dimen/radius_button"
                            app:icon="@drawable/ic_start"
                            app:iconGravity="textStart"
                            app:iconTint="@color/md_success"
                            app:iconPadding="@dimen/dp_8" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!--
              任务列表：纯标题 + 卡片列表。
              外层不再套 SectionCard（一任务一卡片，再套一层会变成卡片套卡片），与 DC 控制端一致。
              标题右侧给一行手势提示：左滑是新交互，不提示用户很难发现。
            -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/dp_4"
                android:paddingEnd="@dimen/dp_4">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="任务列表"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:textColor="@color/md_onSurface" />

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="左滑编辑 · 长按详情"
                    android:textColor="@color/md_onSurfaceVariant"
                    android:textSize="@dimen/sp_11" />
            </LinearLayout>

            <!-- 列表底部留白让最后一项可滚出悬浮导航之上；滚动时内容从磨砂导航下掠过 -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="@dimen/dp_2">

                <!-- 横向 padding 4dp：叠加 contentView 的 12dp 后页面边距为 16dp（与 DC 一致）；
                     底部留白 152dp：同时避开悬浮导航与右下角悬浮添加按钮，避免最后一张卡片被压住 -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingStart="@dimen/dp_4"
                    android:paddingTop="@dimen/dp_4"
                    android:paddingEnd="@dimen/dp_4"
                    android:paddingBottom="@dimen/task_list_bottom_inset"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                <com.pengxh.kt.lite.widget.EmptyView
                    android:id="@+id/emptyView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone"
                    app:show_reload_button="false" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 添加任务按钮：紫罗兰渐变圆底 + 品牌染色立体投影（elevation 16dp 拉开层次） -->
    <FrameLayout
        android:id="@+id/fabAddTask"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="88dp"
        android:background="@drawable/bg_fab_gradient"
        android:contentDescription="添加任务"
        android:elevation="16dp"
        android:outlineAmbientShadowColor="@color/fab_shadow"
        android:outlineSpotShadowColor="@color/fab_shadow"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_menu_add"
            app:tint="@color/md_onSurface"
            android:contentDescription="@null" />
    </FrameLayout>
</FrameLayout>