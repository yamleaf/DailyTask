<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingStart="@dimen/dp_20"
    android:paddingEnd="@dimen/dp_20"
    android:paddingBottom="@dimen/dp_16">

    <!-- 顶部手柄 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="@dimen/dp_32"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/dp_12"
        android:layout_marginBottom="@dimen/dp_16"
        app:cardBackgroundColor="@color/md_outline"
        app:cardCornerRadius="2dp"
        app:strokeWidth="0dp" />

    <!-- 标题 -->
    <com.google.android.material.textview.MaterialTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="选择工作日"
        android:textColor="@color/md_onSurface"
        android:textSize="@dimen/sp_18"
        android:textStyle="bold" />

    <!-- 副标题提示 -->
    <com.google.android.material.textview.MaterialTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_2"
        android:text="至少保留一天为工作日"
        android:textColor="@color/md_onSurfaceVariant"
        android:textSize="@dimen/sp_12" />

    <!-- 工作日网格 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        android:nestedScrollingEnabled="false"
        android:overScrollMode="never"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="4"
        tools:listitem="@layout/item_workday_rv_g" />

    <!-- 底部对称按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancelButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_44"
            android:layout_weight="1"
            android:text="取消"
            android:textColor="@color/md_onSurfaceVariant"
            app:cornerRadius="@dimen/radius_button"
            app:strokeColor="@color/md_outline" />

        <Space
            android:layout_width="@dimen/dp_12"
            android:layout_height="wrap_content" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/confirmButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_44"
            android:layout_weight="1"
            android:text="确定"
            app:cornerRadius="@dimen/radius_button" />
    </LinearLayout>
</LinearLayout>
