<?xml version="1.0" encoding="utf-8"?>
<!--
  DT 任务卡片：一个任务一张独立卡片（与 DC 任务列表同一套视觉与交互）。

  根节点 SwipeRevealLayout 约定：第 1 个子 View = 左滑露出的操作面板，第 2 个子 View = 内容卡片。
  原先「左侧 24dp 链轨列 + 计划时间标签 + 对比箭头 + 点击展开的大号实际时间」已移除：
  链式节点改由 ChainLineDecoration 画在卡片左内侧，实际执行时间改由右下淡灰小卡常驻展示。
-->
<com.pengxh.daily.app.widget.SwipeRevealLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipeRevealLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!--
      左滑操作面板：一叠斜放的小卡片（层层错位堆叠）。
      两卡都是 72×88dp 的固定尺寸、垂直居中，不撑满整行高度（避免"大木板"观感）。
      两卡水平错开由代码的 translationX 驱动，仅留约 6dp 重叠 —— 各自文字完整可见、各自可点。
      面板总宽 150dp = 内容层最大左移距离。
    -->
    <FrameLayout
        android:id="@+id/actionPanel"
        android:layout_width="150dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:clipChildren="false">

        <!-- 底层：删除卡（右、下沉、顺时针倾斜） -->
        <TextView
            android:id="@+id/btnActionDelete"
            android:layout_width="72dp"
            android:layout_height="88dp"
            android:layout_gravity="center_vertical|end"
            android:background="@drawable/bg_task_action_delete"
            android:elevation="1dp"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:paddingHorizontal="@dimen/dp_2"
            android:text="删除"
            android:textColor="@android:color/white"
            android:textSize="@dimen/sp_13"
            android:textStyle="bold" />

        <!-- 上层：编辑卡（左、上浮、逆时针倾斜），水平错开 66dp -->
        <TextView
            android:id="@+id/btnActionEdit"
            android:layout_width="72dp"
            android:layout_height="88dp"
            android:layout_gravity="center_vertical|end"
            android:background="@drawable/bg_task_action_edit"
            android:elevation="2dp"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:paddingHorizontal="@dimen/dp_2"
            android:text="编辑"
            android:textColor="@android:color/white"
            android:textSize="@dimen/sp_13"
            android:textStyle="bold" />

    </FrameLayout>

    <!-- 内容层：任务卡片 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/taskCardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="6dp"
        android:foreground="?attr/selectableItemBackground"
        app:cardBackgroundColor="@color/md_surface"
        app:cardCornerRadius="@dimen/radius_xl"
        app:cardElevation="0dp"
        app:strokeColor="@color/md_outlineVariant"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/dp_16">

            <!-- 首行：任务执行时间 + 备注（无备注保持空位）+ 状态胶囊 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/taskTimeView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:text="08:00:00"
                    android:textColor="@color/md_onSurface"
                    android:textSize="@dimen/sp_22"
                    android:textStyle="bold"
                    tools:text="08:23:00" />

                <!-- 备注：无备注时文本留空、控件保留，行高与布局保持稳定 -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/taskNameView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_12"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:minWidth="0dp"
                    android:textColor="@color/md_onSurfaceVariant"
                    android:textSize="@dimen/sp_13"
                    tools:text="早班打卡" />

                <!-- 状态胶囊：文案与配色由 Adapter 按状态驱动。
                     圆角取 10dp ≈ 控件高度一半，渲染成真正的胶囊（radius_pill 只有 8dp，会露出直角边） -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/stateCardView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_8"
                    app:cardBackgroundColor="@color/md_surfaceVariant"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/stateTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/dp_10"
                        android:layout_marginVertical="2dp"
                        android:text="-"
                        android:textColor="@color/md_onSurfaceVariant"
                        android:textSize="@dimen/sp_12"
                        android:textStyle="bold" />
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- 第二行：两张淡灰小卡片，左随机窗口 / 右实际执行 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/cardRandomWindow"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_task_sub_card"
                    android:orientation="vertical"
                    android:padding="@dimen/dp_12">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="随机窗口"
                        android:textColor="@color/md_onSurfaceVariant"
                        android:textSize="@dimen/sp_12" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/randomTimeView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_6"
                        android:ellipsize="end"
                        android:fontFamily="monospace"
                        android:maxLines="1"
                        android:textColor="@color/md_onSurface"
                        android:textSize="@dimen/sp_15"
                        android:textStyle="bold"
                        tools:text="08:23 - 08:27" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardActualTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_task_sub_card"
                    android:orientation="vertical"
                    android:padding="@dimen/dp_12">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="实际执行"
                        android:textColor="@color/md_onSurfaceVariant"
                        android:textSize="@dimen/sp_12" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/actualTimeView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_6"
                        android:ellipsize="end"
                        android:fontFamily="monospace"
                        android:maxLines="1"
                        android:text="--:--:--"
                        android:textColor="@color/md_onSurface"
                        android:textSize="@dimen/sp_15"
                        android:textStyle="bold"
                        tools:text="08:24:31" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</com.pengxh.daily.app.widget.SwipeRevealLayout>
