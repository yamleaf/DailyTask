<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <!-- 左侧链式节点列，连线由 ChainLineDecoration 统一绘制 -->
    <FrameLayout
        android:layout_width="@dimen/chain_track_width"
        android:layout_height="match_parent">

        <!-- 扩散光圈（执行中雷达波纹）：默认透明不可见，动画时 alpha/scale 由代码驱动 -->
        <View
            android:id="@+id/chainRippleView"
            android:layout_width="@dimen/chain_dot_size"
            android:layout_height="@dimen/chain_dot_size"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/chain_dot_top"
            android:background="@drawable/shape_chain_dot"
            android:alpha="0" />

        <View
            android:id="@+id/chainDotView"
            android:layout_width="@dimen/chain_dot_size"
            android:layout_height="@dimen/chain_dot_size"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/chain_dot_top"
            android:background="@drawable/shape_chain_dot" />
    </FrameLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/taskCardView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        app:cardBackgroundColor="@color/md_surface"
        app:cardCornerRadius="@dimen/radius_card"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/dp_12">

            <!-- 计划时间部分 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="计划时间"
                            android:textColor="@color/md_onSurfaceVariant"
                            android:textSize="@dimen/sp_14"
                            android:textStyle="bold" />

                        <!-- 右上角状态药丸（执行中/已完成/已跳过/-），文案配色由 Adapter 驱动 -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/stateCardView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/dp_8"
                            app:cardBackgroundColor="@color/md_surfaceVariant"
                            app:cardCornerRadius="@dimen/radius_pill"
                            app:strokeWidth="0dp">

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/stateTextView"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="@dimen/dp_10"
                                android:layout_marginVertical="2dp"
                                android:text="-"
                                android:textColor="@color/md_onSurfaceVariant"
                                android:textSize="@dimen/sp_12"
                                android:textStyle="bold" />
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/taskTimeView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="08:00"
                        android:textColor="@color/md_onSurface"
                        android:textSize="@dimen/sp_30"
                        android:textStyle="bold" />

                    <!-- 随机窗口展示（借鉴 master，开启随机时间时显示 "起始 - 结束"） -->
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/randomTimeView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:visibility="gone"
                        android:text="随机窗口 --:-- - --:--"
                        android:textColor="@color/md_onSurfaceVariant"
                        android:textSize="@dimen/sp_12" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/taskNameView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:textColor="@color/md_onSurfaceVariant"
                        android:textSize="@dimen/sp_14" />

                    <!-- 有备注时在备注下、无备注时在计划时间下：小字展示当日实际执行时间 -->
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/taskActualHintView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/md_primary"
                        android:textSize="@dimen/sp_12" />
                </LinearLayout>

                <!-- 中间的对比图标 -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/md_surfaceVariant"
                    app:cardCornerRadius="@dimen/radius_card"
                    app:strokeColor="@color/md_outlineVariant"
                    app:strokeWidth="1dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/arrowView"
                        android:layout_width="@dimen/dp_32"
                        android:layout_height="@dimen/dp_32"
                        android:layout_gravity="center"
                        android:padding="@dimen/dp_8"
                        android:src="@drawable/ic_arrow_right"
                        android:contentDescription="@null" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- 分隔线 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="@dimen/dp_8"
                android:background="@drawable/divider_gradient" />

            <!-- 实际时间部分 -->
            <LinearLayout
                android:id="@+id/actualTimeCardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:orientation="vertical">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="实际时间"
                        android:textColor="@color/md_primary"
                        android:textSize="@dimen/sp_14"
                        android:textStyle="bold" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/actualTimeView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--:--:--"
                        android:textColor="@color/md_onSurface"
                        android:textSize="@dimen/sp_30"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
