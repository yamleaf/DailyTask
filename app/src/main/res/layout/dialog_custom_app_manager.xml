<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.textview.MaterialTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_custom_target_app_tip"
        android:textColor="@color/md_onSurfaceVariant"
        android:textSize="@dimen/sp_12" />

    <FrameLayout
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp_12"
        android:layout_weight="1"
        android:minHeight="@dimen/dialog_min_height" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:orientation="vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickFromInstalled"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_48"
            android:text="@string/settings_custom_app_pick"
            android:textSize="@dimen/sp_16" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnManualInput"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_48"
            android:layout_marginTop="@dimen/dp_12"
            android:text="@string/settings_custom_app_manual"
            android:textSize="@dimen/sp_16" />
    </LinearLayout>
</LinearLayout>
