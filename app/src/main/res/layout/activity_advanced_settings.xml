<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_gradient"
        app:navigationIcon="@drawable/ic_title_left"
        app:title="高级设置"
        app:titleTextColor="@color/on_header" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ══════ Shizuku 服务（胶囊化状态 + 授权按钮）══════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_12"
                style="@style/Widget.Daily.SectionCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="服务权限状态"
                        android:textColor="@color/md_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txtShizukuStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_chip"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="5dp"
                            android:text="服务：不可用"
                            android:textColor="@color/md_onSurfaceVariant"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/txtShizukuAuth"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_chip"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="5dp"
                            android:text="授权：未授权"
                            android:textColor="@color/md_onSurfaceVariant"
                            android:textSize="12sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnShizukuAuth"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minHeight="0dp"
                            android:minWidth="0dp"
                            android:paddingHorizontal="8dp"
                            android:text="去授权"
                            android:textColor="@color/md_primary"
                            android:textSize="12sp"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ══════ 登录配置（配置区）══════ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_12"
                style="@style/Widget.Daily.SectionCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="16dp"
                        android:paddingTop="14dp"
                        android:paddingEnd="16dp"
                        android:text="登录配置"
                        android:textColor="@color/md_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- 登录方式（当前生效方式，控制端可切换） -->
                    <LinearLayout
                        android:id="@+id/layoutLoginMethod"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/itemLayoutHeight"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="登录方式"
                            android:textColor="@color/md_onSurface"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/txtLoginMethod"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/md_onSurfaceVariant"
                            android:textSize="14sp" />

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_arrow_right"
                            android:contentDescription="@null" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:background="@color/md_outlineVariant" />

                    <!-- 密码缓存 -->
                    <LinearLayout
                        android:id="@+id/layoutPassword"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/itemLayoutHeight"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="密码缓存"
                                android:textColor="@color/md_onSurface"
                                android:textSize="15sp" />

                            <TextView
                                android:id="@+id/txtPasswordStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="未设置"
                                android:textColor="@color/md_onSurfaceVariant"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_arrow_right"
                            android:contentDescription="@null" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:background="@color/md_outlineVariant" />

                    <!-- 密码登录步骤 -->
                    <LinearLayout
                        android:id="@+id/layoutPwdSteps"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/itemLayoutHeight"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="密码登录步骤"
                                android:textColor="@color/md_onSurface"
                                android:textSize="15sp" />

                            <TextView
                                android:id="@+id/txtPwdSteps"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="默认"
                                android:textColor="@color/md_onSurfaceVariant"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_arrow_right"
                            android:contentDescription="@null" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:background="@color/md_outlineVariant" />

                    <!-- 验证码登录步骤 -->
                    <LinearLayout
                        android:id="@+id/layoutVerifySteps"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/itemLayoutHeight"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="验证码登录步骤"
                                android:textColor="@color/md_onSurface"
                                android:textSize="15sp" />

                            <TextView
                                android:id="@+id/txtVerifySteps"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="默认"
                                android:textColor="@color/md_onSurfaceVariant"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_arrow_right"
                            android:contentDescription="@null" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:background="@color/md_outlineVariant" />

                    <!-- 验证码超时 -->
                    <LinearLayout
                        android:id="@+id/layoutVerifyWait"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/itemLayoutHeight"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="验证码超时"
                            android:textColor="@color/md_onSurface"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/txtVerifyWait"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/md_onSurfaceVariant"
                            android:textSize="14sp" />

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_arrow_right"
                            android:contentDescription="@null" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ══════ 身份验证（配置区）══════ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAuth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_12"
                style="@style/Widget.Daily.SectionCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="16dp"
                        android:paddingTop="14dp"
                        android:paddingEnd="16dp"
                        android:text="身份验证配置"
                        android:textColor="@color/md_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- 身份验证超时 -->
                    <LinearLayout
                        android:id="@+id/layoutAuthWait"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/itemLayoutHeight"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="验证码超时"
                            android:textColor="@color/md_onSurface"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/txtAuthWait"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/md_onSurfaceVariant"
                            android:textSize="14sp" />

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_arrow_right"
                            android:contentDescription="@null" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:background="@color/md_outlineVariant" />

                    <!-- 操作步骤 -->
                    <LinearLayout
                        android:id="@+id/layoutAuthSteps"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/itemLayoutHeight"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="操作步骤"
                                android:textColor="@color/md_onSurface"
                                android:textSize="15sp" />

                            <TextView
                                android:id="@+id/txtAuthSteps"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="默认"
                                android:textColor="@color/md_onSurfaceVariant"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_arrow_right"
                            android:contentDescription="@null" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ══════ 模拟打卡（配置区）══════ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPunch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_12"
                style="@style/Widget.Daily.SectionCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="16dp"
                        android:paddingTop="14dp"
                        android:paddingEnd="16dp"
                        android:text="模拟打卡配置"
                        android:textColor="@color/md_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- 操作步骤 -->
                    <LinearLayout
                        android:id="@+id/layoutPunchSteps"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/itemLayoutHeight"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="操作步骤"
                                android:textColor="@color/md_onSurface"
                                android:textSize="15sp" />

                            <TextView
                                android:id="@+id/txtPunchSteps"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="默认"
                                android:textColor="@color/md_onSurfaceVariant"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_arrow_right"
                            android:contentDescription="@null" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 说明 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingHorizontal="4dp"
                android:lineSpacingExtra="4dp"
                android:text="配置说明：\n· 每步选择类型，并用「从当前屏幕采集坐标」点选按钮位置。\n· 点击坐标＝点按钮；密码/验证码输入＝点输入框后回填；验证信息采集＝通知你发送短信。\n· 多格验证码（1 格 1 位）需添加多个「验证码输入」步骤，逐格点选。"
                android:textColor="@color/md_onSurfaceVariant"
                android:textSize="12sp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>